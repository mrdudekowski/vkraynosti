# CMS / S3 — только бакет vkraynosti-cms-dev (не прод, не календарь сайта).
# Скопируйте в .env.cms-dev и подставьте ключи. .env.cms-dev в git не попадает.
#
# API (`npm run cms:api` / `npm run dev:cms`) читает этот файл сам.
#
# TimeWeb: если в панели бакет — UUID, а «vkraynosti-cms-dev» только имя,
# в S3_BUCKET и в S3_PUBLIC_BASE_URL поставьте UUID.

S3_BUCKET=vkraynosti-cms-dev
AWS_ENDPOINT_URL=https://s3.twcstorage.ru
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_FORCE_PATH_STYLE=true

# Весь бакет изолирован под CMS-dev — префикс не обязателен.
# Папки внутри: draft/ published/ media/ private/
S3_PREFIX=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Те же ключи для CMS API. Можно оставить пустыми,
# если заполнены AWS_* — тогда дублировать не нужно.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Прямой origin бакета (со слэшем в конце). CDN для dev не обязателен.
# Пример с UUID: https://s3.twcstorage.ru/________-____-____-____-____________/
S3_PUBLIC_BASE_URL=https://s3.twcstorage.ru/vkraynosti-cms-dev/

# Для Vite overlay (дублируйте в .env.local — Vite не читает .env.cms-dev):
# VITE_CMS_S3_BASE_URL=https://s3.twcstorage.ru/vkraynosti-cms-dev/

# Админка (localhost). Пароли не коммитьте — только в .env.cms-dev.
# Первый запуск API записывает их в private/users.json (хеш). Дальше люди
# управляются из админки, env нужен как запасной сид, если файла ещё нет.
# Если 8787 занят (другой проект), запуск: CMS_API_PORT=8788 npm run dev:cms
CMS_API_PORT=8787
CMS_AUTH_SECRET=change-me-at-least-16
CMS_ADMIN_LOGIN=
CMS_ADMIN_PASSWORD=
CMS_EDITOR_LOGIN=
CMS_EDITOR_PASSWORD=
# Секрет для сайта и Telegram-бота: POST /api/cms/crm/inbound
# Authorization: Bearer …
CMS_CRM_INBOUND_SECRET=

DATABASE_URL=postgres://vkrainosti:local-vkrainosti-only@127.0.0.1:54327/vkrainosti
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10
CMS_COOKIE_SECURE=false
